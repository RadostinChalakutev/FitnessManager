<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fitness.controller.MainController"
            stylesheets="@../css/style.css">

    <left>

        <VBox prefWidth="220"
              spacing="15"
              styleClass="sidebar">

            <Label text="FITNESS MANAGER"
                   styleClass="sidebar-title"/>

            <Button text="Dashboard"
                    styleClass="sidebar-button"/>

            <Button text="Members"
                    styleClass="sidebar-button"
                    onAction="#openMembers"/>

        </VBox>

    </left>

    <center>

        <VBox spacing="20"
              styleClass="content">

            <HBox spacing="15"
                  alignment="CENTER_LEFT">

                <Label text="Dashboard"
                       styleClass="page-title"/>

                <TextField fx:id="searchField"
                           promptText="Search members..."
                           prefWidth="300"
                           styleClass="search-field"/>

                <Button text="+ Add Member"
                        onAction="#openMembers"
                        styleClass="primary-button"/>

            </HBox>

            <TableView fx:id="membersTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="firstNameColumn"
                                 text="First Name"
                                 prefWidth="120"/>

                    <TableColumn fx:id="lastNameColumn"
                                 text="Last Name"
                                 prefWidth="120"/>

                    <TableColumn fx:id="phoneColumn"
                                 text="Phone"
                                 prefWidth="130"/>

                    <TableColumn fx:id="subscriptionColumn"
                                 text="Subscription"
                                 prefWidth="130"/>

                    <TableColumn fx:id="daysRemainingColumn"
                                 text="Days Remaining"
                                 prefWidth="130"/>

                    <TableColumn fx:id="endDateColumn"
                                 text="End Date"
                                 prefWidth="120"/>

                    <TableColumn fx:id="editColumn"
                                 text="Action"
                                 prefWidth="90"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>