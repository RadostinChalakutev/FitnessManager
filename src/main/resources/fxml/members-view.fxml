<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fitness.controller.MemberController"
            stylesheets="@../css/style.css">

    <center>

        <VBox spacing="25"
              styleClass="content">

            <HBox spacing="15"
                  alignment="CENTER_LEFT">

                <Button text="← Back"
                        styleClass="secondary-button"
                        onAction="#goBack"/>

                <Label fx:id="formTitle"
                       text="Add New Member"
                       styleClass="page-title"/>

            </HBox>

            <VBox spacing="20"
                  styleClass="card">

                <GridPane hgap="20"
                          vgap="15">

                    <padding>
                        <Insets top="10"
                                right="10"
                                bottom="10"
                                left="10"/>
                    </padding>

                    <Label text="First Name"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="firstNameField"
                               promptText="Enter first name"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                    <Label text="Last Name"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="lastNameField"
                               promptText="Enter last name"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>

                    <Label text="Phone"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <TextField fx:id="phoneField"
                               promptText="Enter phone number"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2"/>

                    <Label text="EGN"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>

                    <TextField fx:id="egnField"
                               promptText="Enter EGN"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="3"/>

                    <Label text="Email"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4"/>

                    <TextField fx:id="emailField"
                               promptText="Enter email address"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="4"/>

                    <Label text="Subscription"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="5"/>

                    <ComboBox fx:id="subscriptionComboBox"
                              promptText="Select subscription"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="5"/>

                    <Label text="Start Date"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="6"/>

                    <DatePicker fx:id="startDatePicker"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="6"/>

                    <Label text="End Date"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="7"/>

                    <TextField fx:id="endDateField"
                               editable="false"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="7"/>

                    <Label text="Payment Method"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="8"/>

                    <ComboBox fx:id="paymentMethodComboBox"
                              promptText="Select payment method"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="8"/>

                </GridPane>

                <HBox spacing="15">

                    <Button fx:id="saveButton"
                            text="Save Member"
                            styleClass="primary-button"
                            onAction="#saveMember"/>

                    <Button text="Clear"
                            styleClass="secondary-button"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>